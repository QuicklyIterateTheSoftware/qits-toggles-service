<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-toggles</artifactId>
        <version>2026.1127.64618</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <!-- The domain: the toggles database, its own named datasource and its Flyway lineage
         (META-INF/microprofile-config.properties, db/toggles/migration), and the stores over it:
         plain JDBC, no persistence unit. Internal, not published: `service` builds it from source.

         The directory is `domain/` while the artifactId is `qits-toggles-domain`: generic
         coordinates would collide in the shared ~/.m2 every workspace container mounts. -->
    <artifactId>qits-toggles-domain</artifactId>
    <name>qits-toggles :: domain</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of the core. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- PatientPgDriver, named by the datasource block as a string. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
